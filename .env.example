# ==============================================================================
# Cattle Exchange — Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - NEVER commit real credentials, service keys, or secrets into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Public Configuration (Accessible in browser and server)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Server-Only Secrets (NEVER expose to browser / client bundles)
# ------------------------------------------------------------------------------
# Reserved strictly for administrative migrations, system CLI, or initial admin bootstrap.
# This key bypasses PostgreSQL Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-browser

# Secret used to authorize scheduled storage orphan reconciliation cron jobs
CRON_SECRET=your-cron-secret-token-placeholder

